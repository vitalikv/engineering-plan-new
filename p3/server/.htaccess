RewriteEngine On

# Thumbs: если файл есть — Apache отдаёт статику, если нет — PHP генерирует
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^storage/textures/thumbs/(.+)$ api/thumb.php?file=$1 [L,QSA]

RewriteRule ^api/auth/login$ api/auth/login.php [L,QSA]
RewriteRule ^api/auth/register$ api/auth/register.php [L,QSA]
RewriteRule ^api/auth/logout$ api/auth/logout.php [L,QSA]
RewriteRule ^api/auth/me$ api/auth/me.php [L,QSA]
RewriteRule ^api/auth/forgot-password$ api/auth/forgot-password.php [L,QSA]
RewriteRule ^api/auth/verify-email$ api/auth/verify-email.php [L,QSA]
RewriteRule ^api/auth/resend-verification$ api/auth/resend-verification.php [L,QSA]
RewriteRule ^api/auth/reset-password-check$ api/auth/reset-password-check.php [L,QSA]
RewriteRule ^api/auth/reset-password$ api/auth/reset-password.php [L,QSA]
RewriteRule ^api/catalog$ api/catalog.php [L,QSA]
RewriteRule ^api/textures$ api/textures.php [L,QSA]
RewriteRule ^api/thumbs-bundle$ api/thumbs-bundle.php [L,QSA]
RewriteRule ^api/subscription/status$ api/subscription/status.php [L,QSA]
RewriteRule ^api/subscription/pay$ api/subscription/pay.php [L,QSA]
RewriteRule ^api/subscription/webhook$ api/subscription/webhook.php [L,QSA]
RewriteRule ^api/projects$ api/projects.php [L,QSA]
